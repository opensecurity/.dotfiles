#
# REGISTRY: ~/.inputrc
#
# Readline configuration for bash and all readline-based programs.
# Provides substring history search, smart completion, and navigation.
#

# ============================================================================
#  History Substring Search (Full Substring & Fuzzy Matching)
# ============================================================================

# Up/Down arrows search history matching any substring typed so far.
# Type "build", "prune", or "8080" then press Up to cycle through all matching commands anywhere in the line.
"\e[A": history-substring-search-backward
"\e[B": history-substring-search-forward

# Application mode / SS3 escape codes (used by many terminal emulators).
"\eOA": history-substring-search-backward
"\eOB": history-substring-search-forward

# Ctrl+P / Ctrl+N also perform substring search.
"\C-p": history-substring-search-backward
"\C-n": history-substring-search-forward

# Page Up / Page Down for rapid history substring search.
"\e[5~": history-substring-search-backward
"\e[6~": history-substring-search-forward

# Ctrl+Up / Ctrl+Down (xterm / tmux).
"\e[1;5A": history-substring-search-backward
"\e[1;5B": history-substring-search-forward


# ============================================================================
#  Completion
# ============================================================================

# Case-insensitive tab completion (a-z matches A-Z and vice versa).
set completion-ignore-case on

# Treat hyphens and underscores as equivalent during completion.
set completion-map-case on

# Show all completions on first Tab if ambiguous (no double-tab needed).
set show-all-if-ambiguous on

# Show all completions if there is no partial completion to insert.
set show-all-if-unmodified on

# Color the common prefix in completion lists.
set colored-completion-prefix on

# Color file types according to LS_COLORS in completion lists.
set colored-stats on

# Display common prefix when using menu completion.
set menu-complete-display-prefix on

# Show file type indicators in completion lists (like ls -F).
set visible-stats on

# Append a slash to completed directory names.
set mark-directories on
set mark-symlinked-directories on

# Don't duplicate text when completing in the middle of a word.
set skip-completed-text on

# Display completions using the terminal width efficiently.
set completion-display-width -1

# Limit completion list queries: show up to 200 without asking.
set completion-query-items 200


# ============================================================================
#  Editing & Navigation
# ============================================================================

# Use 8-bit input/output (handle UTF-8 properly).
set input-meta on
set output-meta on
set convert-meta off

# Disable the bell entirely.
set bell-style none

# Do not print ^C on the terminal when cancelling a command.
set echo-control-characters off

# Allow UTF-8 input and output.
set meta-flag on

# Be more intelligent when autocompleting by also looking at the text after
# the cursor. For example, when the current line is "cd /usr/loca"
# and the cursor is on "a", pressing Tab will not autocomplete to
# "cd /usr/markup/markup_local_al" but to "cd /usr/local/".
set skip-completed-text on

# Alt+Left / Alt+Right to move by word (like most modern terminals).
"\e[1;3D": backward-word
"\e[1;3C": forward-word

# Ctrl+Left / Ctrl+Right to move by word (alternate escape codes).
"\e[1;5D": backward-word
"\e[1;5C": forward-word

# Shift+Tab to cycle backward through completions.
"\e[Z": menu-complete-backward

# Path-aware word deletion (Ctrl+W deletes up to nearest '/' instead of whole line).
"\C-w": unix-filename-rubout

# Bracketed paste mode (protects against accidental execution of pasted multi-line commands).
set enable-bracketed-paste on

# Ctrl+Backspace / Ctrl+Delete to kill word.
"\e[3;5~": kill-word
"\C-h": backward-kill-word

# Delete key
"\e[3~": delete-char

# Home / End keys (standard ANSI, xterm, rxvt)
"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[H": beginning-of-line
"\e[F": end-of-line
"\eOH": beginning-of-line
"\eOF": end-of-line
